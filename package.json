{
  "name": "fetch-request",
  "version": "0.1.0",
  "description": "A lightweight typed request client built on fetch and XMLHttpRequest upload progress.",
  "type": "module",
  "license": "MIT",
  "author": "kelei321",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelei321/fetch-request.git"
  },
  "homepage": "https://github.com/kelei321/fetch-request#readme",
  "bugs": {
    "url": "https://github.com/kelei321/fetch-request/issues"
  },
  "keywords": [
    "fetch",
    "request",
    "http",
    "typescript",
    "xhr",
    "upload"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck:tests": "tsc -p test/tsconfig.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:examples && npm run typecheck:tests",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
